{
  "manifest_version": 3,
  "name": "Akura — Sinhala Legacy Copy",
  "version": "1.0.0",
  "description": "Highlight Sinhala text on a webpage and copy it as FMBasuru legacy text.",
  "permissions": ["storage", "clipboardWrite"],
  "icons": {"16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png"},
  "action": {
    "default_title": "Akura — Sinhala Legacy Copy",
    "default_popup": "popup.html"
  },
  "content_scripts": [{
    "matches": ["http://*/*", "https://*/*"],
    "js": ["converter.js", "clipboard.js", "content.js"],
    "run_at": "document_idle",
    "all_frames": true
  }]
}
